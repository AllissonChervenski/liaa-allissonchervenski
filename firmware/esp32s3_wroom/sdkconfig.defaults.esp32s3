# Target hardware: ESP32-S3-WROOM (Xtensa Dual-Core LX7 @ 240 MHz)
CONFIG_IDF_TARGET="esp32s3"

# CPU & FreeRTOS SMP Dual-Core Configuration
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# Compiler optimization for deterministic low-latency DSP & TinyML
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash Partition Table (4MB minimum default; works on 4MB/8MB/16MB WROOM modules)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console & HIL Transport via native USB-Serial/JTAG (/dev/ttyACM*)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Default sEMG Application Configuration
CONFIG_SEMG_ACQ_MODE_HIL_SERIAL=y
CONFIG_SEMG_HIL_TRANSPORT_USB_JTAG=y
CONFIG_SEMG_MODEL_MICRO_LDA_Q7=y
CONFIG_SEMG_DATASET_OZDEMIR_4CH=y
CONFIG_SEMG_RUN_BOOT_SELFTEST=y
CONFIG_SEMG_ENABLE_BANDPASS_FILTER=y
CONFIG_SEMG_ADC_OVERSAMPLE_FACTOR=4
CONFIG_SEMG_STATUS_LED_GPIO=-1
